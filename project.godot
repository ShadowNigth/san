; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CS2GO - Godot 4 Edition"
config/description="Port a Godot 4 de 3kh0/cs2go: simulación a 128 Hz, movimiento Source, 37 armas, Dust II, C4, granadas, economía y bots tácticos."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icons/buy/c4.svg"

[autoload]

GameData="*res://autoload/GameData.gd"
SettingsManager="*res://autoload/SettingsManager.gd"
AudioManager="*res://autoload/AudioManager.gd"
MatchManager="*res://autoload/MatchManager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/stratum2-regular.woff2"

